{
  "name": "sketchling",
  "version": "0.3.0",
  "description": "A hand-drawn illustration and animation language for LLMs — like Manim, but for expressive Notion/Anthropic-style sketch illustration.",
  "type": "module",
  "license": "MIT",
  "author": "Anay Garodia",
  "keywords": [
    "hand-drawn",
    "animation",
    "illustration",
    "svg",
    "sketch",
    "rough.js",
    "gsap",
    "llm",
    "ai",
    "creative-coding",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnayGarodia/sketchling.git"
  },
  "homepage": "https://github.com/AnayGarodia/sketchling#readme",
  "bugs": {
    "url": "https://github.com/AnayGarodia/sketchling/issues"
  },
  "bin": {
    "sketchling": "bin/sketchling.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-harness.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build",
    "demo": "npm run build && node bin/sketchling.js render examples/keyhole-laptop.ts --out preview.png",
    "lint": "eslint ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "gsap": "^3.12.5",
    "playwright": "^1.48.0",
    "roughjs": "^4.6.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0"
  }
}
