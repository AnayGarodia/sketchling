{
  "name": "sketchling",
  "version": "0.1.0",
  "description": "A hand-drawn illustration and animation language for LLMs — like Manim, but for expressive Notion/Anthropic-style sketch illustration.",
  "type": "module",
  "license": "MIT",
  "author": "Anay Garodia",
  "keywords": [
    "hand-drawn",
    "animation",
    "illustration",
    "svg",
    "sketch",
    "rough.js",
    "gsap",
    "llm",
    "ai",
    "creative-coding",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "sketchling": "./bin/sketchling.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "demo": "npm run build && node bin/sketchling.js render examples/keyhole-laptop.ts --out preview.png"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "gsap": "^3.12.5",
    "playwright": "^1.48.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  }
}
